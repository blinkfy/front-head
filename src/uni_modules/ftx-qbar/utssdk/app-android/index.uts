import { UTSAndroid } from 'io.dcloud.uts'
import QbarBridge from 'ftx.qbar.QbarBridge'

export function isAvailable(): boolean {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) return false
  return QbarBridge.isAvailable(activity!)
}

export function startScan(callback: (result: string) => void): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    callback('{"error":"UNAVAILABLE"}')
    return
  }
  QbarBridge.start(activity!, callback)
}

export function startScanWithDiagnostics(callback: (result: string) => void): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    callback('{"error":"UNAVAILABLE"}')
    return
  }
  QbarBridge.startDebug(activity!, callback)
}

export function cancelScan(): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity != null) QbarBridge.cancel(activity!)
}

// Missing native methods in an older base return UNAVAILABLE via the reflection bridge.
export function decodeGeneratedImage(encoded: string, callback: (result: string) => void): void {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) { callback('{"error":"UNAVAILABLE"}'); return }
  QbarBridge.decodeGeneratedImage(activity!, encoded, callback)
}
